<UserControl x:Class="DuplicateHunter.UI.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="10,0,10,20">

            <Border Style="{StaticResource CardStyle}">

                <StackPanel Margin="20"
                            HorizontalAlignment="Stretch">

                    <!-- Title & Header -->
                    <TextBlock Text="Folder Duplicate Scanner"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Margin="0,8,0,25"
                               Text="Select a target directory to calculate SHA-256 cryptographic hashes and identify duplicates."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               TextAlignment="Center"/>

                    <!-- Folder Selection Group -->
                    <Border Padding="16"
                            Background="#F8FAFC"
                            CornerRadius="10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Target Folder Path:"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedFolder}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="📁 Browse Folder"
                                    Height="42"
                                    Padding="16,0"
                                    Margin="15,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseFolderCommand}"/>
                        </Grid>

                    </Border>

                    <!-- Scan Action Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,30,0,0">

                        <Button Content="🔍 Start Scan"
                                Width="220"
                                Height="52"
                                Margin="0,0,15,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartScanCommand}"/>

                        <Button Content="⛔ Stop Scan"
                                Width="180"
                                Height="52"
                                Margin="0,0,15,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding StopScanCommand}"
                                IsEnabled="{Binding IsScanning}"/>

                        <Button Content="🔄 Refresh Results"
                                Width="180"
                                Height="52"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshResultsCommand}"/>

                    </StackPanel>

                    <!-- Progress Section -->
                    <Border Margin="0,30,0,0"
                            Padding="20"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <StackPanel>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Scan Progress"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding ScanProgress, StringFormat={}{0:F0}%}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <ProgressBar Height="20"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ScanProgress}"/>

                            <!-- Scan Status -->
                            <TextBlock Text="{Binding ScanStatus}"
                                       Margin="0,16,0,0"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"/>

                            <!-- Current File -->
                            <TextBlock Text="{Binding CurrentFile}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

                        </StackPanel>

                    </Border>

                    <!-- Jump to Results Banner -->
                    <Border Margin="0,20,0,0"
                            Padding="14"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8">
                        <DockPanel>
                            <Button Content="View Duplicate Results →"
                                    DockPanel.Dock="Right"
                                    Height="36"
                                    Padding="14,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Results"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Found Duplicates?"
                                           FontWeight="Bold"
                                           Foreground="#1E40AF"
                                           FontSize="13"/>
                                <TextBlock Text="Navigate to the Results tab to inspect, compare, and safely delete duplicates."
                                           FontSize="12"
                                           Foreground="#3B82F6"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>