<UserControl x:Class="DuplicateHunter.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750"
             d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="10,0,10,20">

            <!-- Header -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Application Settings &amp; Filters"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Manage scanner exclusion policies, size constraints, and persistent preferences."
                               Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="💾 Save Settings"
                            Margin="4,0"
                            Padding="16,10"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveSettingsCommand}"/>
                    <Button Content="↺ Reset Defaults"
                            Margin="4,0"
                            Padding="14,10"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetSettingsCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- Configuration Card -->
            <Border Style="{StaticResource CardStyle}">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Appearance & Size Limits -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="General &amp; Size Constraints"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <!-- Theme -->
                        <TextBlock Text="Theme Preference"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox Height="38"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Theme, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Options: System, Dark, Light (Persisted for application theming)"
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="0,4,0,16"/>

                        <!-- Default Minimum File Size -->
                        <TextBlock Text="Default Minimum File Size (MB)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox Height="38"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DefaultMinimumFileSizeMB, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        <TextBlock Text="Files smaller than this threshold will be skipped during scanning (leave empty for no limit)."
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap"/>

                        <!-- Default Maximum File Size -->
                        <TextBlock Text="Default Maximum File Size (MB)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox Height="38"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DefaultMaximumFileSizeMB, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        <TextBlock Text="Files larger than this threshold will be skipped during scanning (leave empty for no limit)."
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- Right Column: Exclusions & Filters -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Scan Exclusion Rules"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <!-- Ignored Folders -->
                        <TextBlock Text="Ignored Folders"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox Height="100"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding IgnoreFoldersText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="E.g., node_modules, .git, AppData, $Recycle.Bin (separated by commas or new lines)."
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap"/>

                        <!-- Ignored Extensions -->
                        <TextBlock Text="Ignored File Extensions"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox Height="100"
                                 Padding="10,8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding IgnoreExtensionsText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="E.g., .dll, .exe, .sys, .tmp, .pdb (separated by commas or new lines)."
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Persistence Info Banner -->
            <Border Margin="0,15,0,0"
                    Padding="16"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Database Synchronization"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="All settings are stored in local SQLite database (duplicate-hunter.db) and applied automatically to subsequent scan operations."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
