<UserControl x:Class="DuplicateHunter.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="10,0,10,20">

            <!-- Hero Banner -->
            <Border Style="{StaticResource CardStyle}"
                    Background="#1E293B"
                    BorderThickness="0"
                    Padding="30">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="🛡️"
                               FontSize="56"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Duplicate Hunter"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <Border Margin="12,0,0,0"
                                    Padding="8,3"
                                    Background="#2563EB"
                                    CornerRadius="12"
                                    VerticalAlignment="Center">
                                <TextBlock Text="PRO EDITION"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Professional Windows File Deduplication &amp; Storage Optimization Utility"
                                   FontSize="14"
                                   Foreground="#CBD5E1"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Version 1.0.0 • .NET 10 WPF Desktop Architecture"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

            </Border>

            <!-- Overview & Capabilities Cards -->
            <Grid Margin="0,15,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: Core Capabilities -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Key Capabilities"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="• Cryptographic SHA-256 Hashing"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Bit-accurate duplicate detection ensuring zero false positives across all file types."
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="• Safe Duplicate Management"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Move files safely to the Windows Recycle Bin or perform permanent deletions with explicit confirmation dialogs."
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="• Smart Selection Presets"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Automatically keep newest, oldest, largest, or smallest files per duplicate group with a single click."
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="• Multi-Format Audit Reports"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Export complete duplicate breakdowns to CSV, structured JSON, Excel (.xlsx), and PDF reports."
                                   FontSize="12"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Right Card: Architecture & Security -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Security &amp; Architecture"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="• 100% Local &amp; Private"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="All scanning, hashing, and database logging are executed entirely on your local machine with zero telemetry or network transmission."
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="• Asynchronous Multi-Threaded Scanning"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Non-blocking asynchronous I/O with cancellation tokens and real-time UI progress updates."
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="• SQLite Local Storage"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Embedded database tracks historical scan metrics, recent directories, and report artifacts securely."
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="• Strict MVVM Pattern"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Built with CommunityToolkit.Mvvm, Microsoft Dependency Injection, and modern WPF design standards."
                                   FontSize="12"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Technical Stack Summary -->
            <Border Margin="0,15,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Technology Stack &amp; Libraries"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <UniformGrid Columns="4">
                        <Border Padding="10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4">
                            <StackPanel>
                                <TextBlock Text=".NET 10 &amp; C#" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Target Framework" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4">
                            <StackPanel>
                                <TextBlock Text="WPF Desktop" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Windows Presentation UI" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4">
                            <StackPanel>
                                <TextBlock Text="ClosedXML &amp; PDFSharp" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Excel &amp; PDF Exporters" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4">
                            <StackPanel>
                                <TextBlock Text="SQLite Engine" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Database &amp; Settings Layer" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
