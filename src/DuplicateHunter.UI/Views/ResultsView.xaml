<UserControl x:Class="DuplicateHunter.UI.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DuplicateHunter.UI.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1000"
             d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="10,0,10,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========================================= -->
            <!-- Header & Summary -->
            <!-- ========================================= -->

            <StackPanel Grid.Row="0">
                <TextBlock Text="Duplicate Detection Results"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>

                <TextBlock Text="Filter duplicate clusters, select redundant files, and safely manage storage reclamation."
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>

            <!-- ========================================= -->
            <!-- Search & Filter Card + Export Toolbar -->
            <!-- ========================================= -->

            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}">

                <StackPanel>

                    <DockPanel Margin="0,0,0,15">
                        <TextBlock Text="🔍 Search &amp; Filter Options"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>

                        <!-- Export Reports Buttons -->
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Export Reports:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <Button Content="📊 CSV"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ExportCsvCommand}"/>
                            <Button Content="📋 JSON"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ExportJsonCommand}"/>
                            <Button Content="📈 Excel"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ExportExcelCommand}"/>
                            <Button Content="📄 PDF"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ExportPdfCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel VerticalAlignment="Center">

                        <!-- Filename / Path Search -->
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Search Filename / Path" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBox Width="220" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Extension Filter -->
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Extension (e.g. .pdf)" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBox Width="130" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                     Text="{Binding FilterExtension, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Folder Filter -->
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Folder Contains" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBox Width="160" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                     Text="{Binding FilterFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Duplicate Group Filter -->
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Group Hash / Count" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBox Width="150" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                     Text="{Binding FilterGroupText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Min Size Filter -->
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Min Size (MB)" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBox Width="95" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                     Text="{Binding MinFileSizeMB, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        </StackPanel>

                        <!-- Max Size Filter -->
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="Max Size (MB)" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                            <TextBox Width="95" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                     Text="{Binding MaxFileSizeMB, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        </StackPanel>

                        <!-- Clear Button -->
                        <StackPanel Margin="0,0,0,10" VerticalAlignment="Bottom">
                            <Button Content="❌ Clear Filters" Height="34" Padding="12,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearFiltersCommand}"/>
                        </StackPanel>

                    </WrapPanel>

                </StackPanel>

            </Border>

            <!-- ========================================= -->
            <!-- Duplicate Groups Card -->
            <!-- ========================================= -->

            <Border Grid.Row="4"
                    Style="{StaticResource CardStyle}">

                <StackPanel>

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Duplicate Groups"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Select a group to inspect and compare its duplicate instances below."
                                       FontSize="12"
                                       Foreground="Gray"/>
                        </StackPanel>

                        <!-- Group Actions -->
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                            <Button Content="✨ Keep Newest"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding KeepNewestCommand}"/>
                            <Button Content="⏳ Keep Oldest"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding KeepOldestCommand}"/>
                            <Button Content="📏 Keep Largest"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding KeepLargestCommand}"/>
                            <Button Content="📐 Keep Smallest"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding KeepSmallestCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Height="240"
                              ItemsSource="{Binding DuplicateResults}"
                              SelectedItem="{Binding SelectedDuplicateGroup}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              ColumnHeaderHeight="38"
                              RowHeight="34">

                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="🔑 Copy SHA-256 Hash" Command="{Binding CopySha256Command}"/>
                                <Separator/>
                                <MenuItem Header="✨ Keep Newest File Only" Command="{Binding KeepNewestCommand}"/>
                                <MenuItem Header="⏳ Keep Oldest File Only" Command="{Binding KeepOldestCommand}"/>
                                <MenuItem Header="📏 Keep Largest File Only" Command="{Binding KeepLargestCommand}"/>
                                <MenuItem Header="📐 Keep Smallest File Only" Command="{Binding KeepSmallestCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="SHA-256 Hash"
                                                Binding="{Binding ShortHash}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Files Count"
                                                Binding="{Binding FileCount}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Total Size"
                                                Binding="{Binding FormattedSize}"
                                                Width="150"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

            <!-- ========================================= -->
            <!-- Files In Selected Group Card -->
            <!-- ========================================= -->

            <Border Grid.Row="6"
                    Style="{StaticResource CardStyle}">

                <StackPanel>

                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Files in Selected Group"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Check files to batch delete, or select a single file for granular actions."
                                       FontSize="12"
                                       Foreground="Gray"/>
                        </StackPanel>

                        <!-- Batch Selection Tools -->
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                            <Button Content="☑ Select All"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SelectAllCommand}"/>
                            <Button Content="☐ Deselect All"
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DeselectAllCommand}"/>
                            <Button Content="📁 Select by Folder..."
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SelectByFolderCommand}"/>
                            <Button Content="🏷️ Select by Ext..."
                                    Margin="3,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SelectByExtensionCommand}"/>
                            <Button Content="🗑️ Delete Checked"
                                    Margin="3,0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteSelectedCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Height="270"
                              ItemsSource="{Binding SelectedFiles}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              behaviors:DataGridSelectedItemsBehavior.SelectedItemsSource="{Binding SelectedFileItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              ColumnHeaderHeight="38"
                              RowHeight="34">

                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="☑ Select All" Command="{Binding SelectAllCommand}"/>
                                <MenuItem Header="☐ Deselect All" Command="{Binding DeselectAllCommand}"/>
                                <MenuItem Header="📁 Select by Folder..." Command="{Binding SelectByFolderCommand}"/>
                                <MenuItem Header="🏷️ Select by Extension..." Command="{Binding SelectByExtensionCommand}"/>
                                <Separator/>
                                <MenuItem Header="📄 Open File" Command="{Binding OpenFileCommand}"/>
                                <MenuItem Header="📂 Open Folder in Explorer" Command="{Binding OpenFolderCommand}"/>
                                <MenuItem Header="📋 Copy Full Path" Command="{Binding CopyFullPathCommand}"/>
                                <MenuItem Header="🔑 Copy SHA-256 Hash" Command="{Binding CopySha256Command}"/>
                                <Separator/>
                                <MenuItem Header="⭐ Keep Only This File (Recycle Rest)" Command="{Binding DeleteAllExceptOneCommand}"/>
                                <MenuItem Header="🗑️ Delete Checked Files" Command="{Binding DeleteSelectedCommand}"/>
                                <MenuItem Header="🗑️ Move Single File to Recycle Bin" Command="{Binding MoveToRecycleBinCommand}"/>
                                <MenuItem Header="❌ Delete Single File Permanently" Command="{Binding DeletePermanentlyCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>

                            <DataGridCheckBoxColumn Header="Select"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="70"/>

                            <DataGridTextColumn Header="File Name"
                                                Binding="{Binding FileName}"
                                                IsReadOnly="True"
                                                Width="240"/>

                            <DataGridTextColumn Header="File Path"
                                                Binding="{Binding FilePath}"
                                                IsReadOnly="True"
                                                Width="*"/>

                            <DataGridTextColumn Header="Extension"
                                                Binding="{Binding Extension}"
                                                IsReadOnly="True"
                                                Width="95"/>

                            <DataGridTextColumn Header="Size (Bytes)"
                                                Binding="{Binding Size, StringFormat={}{0:N0}}"
                                                IsReadOnly="True"
                                                Width="130"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- Bottom Action Bar -->
                    <WrapPanel Margin="0,15,0,0" HorizontalAlignment="Right">
                        <Button Content="📄 Open File" Width="120" Height="36" Margin="4,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenFileCommand}"/>
                        <Button Content="📂 Open Folder" Width="130" Height="36" Margin="4,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenFolderCommand}"/>
                        <Button Content="📋 Copy Path" Width="110" Height="36" Margin="4,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CopyFullPathCommand}"/>
                        <Button Content="🔑 Copy Hash" Width="110" Height="36" Margin="4,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CopySha256Command}"/>
                        <Button Content="⭐ Keep Only This" Width="140" Height="36" Margin="4,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeleteAllExceptOneCommand}"/>
                        <Button Content="🗑️ Recycle Bin" Width="120" Height="36" Margin="4,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding MoveToRecycleBinCommand}"/>
                        <Button Content="❌ Delete" Width="100" Height="36" Margin="4,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeletePermanentlyCommand}"/>
                    </WrapPanel>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>