<Window x:Class="DuplicateHunter.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Hunter - Professional File Duplicate Finder"
        Width="1400"
        Height="950"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <!-- Main Layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="275"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">

            <DockPanel>

                <!-- Branding Header -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="18,24,18,20">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Duplicate Hunter"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   TextTrimming="None"/>
                    </StackPanel>

                    <TextBlock Text="SHA-256 Detection Engine"
                               Margin="32,4,0,0"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="#94A3B8"/>

                </StackPanel>

                <!-- Footer Status -->
                <Border DockPanel.Dock="Bottom"
                        Margin="18,12"
                        Padding="12,10"
                        Background="#0F172A"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Status: Engine Ready"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#10B981"/>
                        <TextBlock Text="v1.0.0 Pro Edition"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Links -->
                <StackPanel Margin="14,10">

                    <Button x:Name="DashboardButton"
                            Content="🏠   Dashboard"
                            Height="46"
                            Margin="0,4"
                            Style="{StaticResource NavButtonStyle}"
                            Click="DashboardButton_Click"/>

                    <Button x:Name="ScanButton"
                            Content="📁   Scan Folder"
                            Height="46"
                            Margin="0,4"
                            Style="{StaticResource NavButtonStyle}"
                            Click="ScanButton_Click"/>

                    <Button x:Name="ResultsButton"
                            Content="📄   Results"
                            Height="46"
                            Margin="0,4"
                            Style="{StaticResource NavButtonStyle}"
                            Click="ResultsButton_Click"/>

                    <Button x:Name="HistoryButton"
                            Content="📜   History"
                            Height="46"
                            Margin="0,4"
                            Style="{StaticResource NavButtonStyle}"
                            Click="HistoryButton_Click"/>

                    <Button x:Name="SettingsButton"
                            Content="⚙   Settings"
                            Height="46"
                            Margin="0,4"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SettingsButton_Click"/>

                    <Button x:Name="AboutButton"
                            Content="ℹ   About"
                            Height="46"
                            Margin="0,4"
                            Style="{StaticResource NavButtonStyle}"
                            Click="AboutButton_Click"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="MainContent"
                            Margin="25"/>
        </Grid>

    </Grid>

</Window>