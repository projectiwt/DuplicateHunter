<UserControl x:Class="DuplicateHunter.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850"
             d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="10,0,10,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========================================= -->
            <!-- Header -->
            <!-- ========================================= -->

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Scan &amp; Report History"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Review previous scan executions, detected duplicate telemetry, and generated audit reports."
                               Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="🔄 Refresh Logs"
                            Margin="4,0"
                            Padding="12,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshHistoryCommand}"/>
                    <Button Content="🗑️ Clear History"
                            Margin="4,0"
                            Padding="12,8"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding ClearHistoryCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- ========================================= -->
            <!-- Scan Execution History Table -->
            <!-- ========================================= -->

            <Border Grid.Row="2"
                    Style="{StaticResource CardStyle}">

                <StackPanel>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="📁 Scan History Records"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding ScanHistory.Count, StringFormat={}{0} record(s)}"
                                   FontSize="12"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DataGrid Height="260"
                              ItemsSource="{Binding ScanHistory}"
                              SelectedItem="{Binding SelectedScanHistory}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              ColumnHeaderHeight="38"
                              RowHeight="34">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Completed Date/Time"
                                                Binding="{Binding CompletedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Width="160"/>

                            <DataGridTextColumn Header="Target Folder"
                                                Binding="{Binding FolderPath}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Files Scanned"
                                                Binding="{Binding FilesScanned, StringFormat={}{0:N0}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Duplicate Groups"
                                                Binding="{Binding DuplicateGroups, StringFormat={}{0:N0}}"
                                                Width="125"/>

                            <DataGridTextColumn Header="Wasted Bytes"
                                                Binding="{Binding WastedBytes, StringFormat={}{0:N0}}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Error / Notes"
                                                Binding="{Binding ErrorMessage}"
                                                Width="150"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

            <!-- ========================================= -->
            <!-- Generated Reports History Table -->
            <!-- ========================================= -->

            <Border Grid.Row="4"
                    Style="{StaticResource CardStyle}">

                <StackPanel>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="📄 Exported Report Artifacts"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding ReportHistory.Count, StringFormat={}{0} export(s)}"
                                   FontSize="12"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DataGrid Height="240"
                              ItemsSource="{Binding ReportHistory}"
                              SelectedItem="{Binding SelectedReport}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              ColumnHeaderHeight="38"
                              RowHeight="34">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Generated Date/Time"
                                                Binding="{Binding CreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Width="160"/>

                            <DataGridTextColumn Header="Format"
                                                Binding="{Binding ReportFormat}"
                                                Width="85"/>

                            <DataGridTextColumn Header="Report File Path"
                                                Binding="{Binding ReportPath}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Source Folder"
                                                Binding="{Binding ScanFolderPath}"
                                                Width="220"/>

                            <DataGridTextColumn Header="Duplicates"
                                                Binding="{Binding DuplicateGroups, StringFormat={}{0:N0}}"
                                                Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <WrapPanel Margin="0,15,0,0" HorizontalAlignment="Right">
                        <Button Content="📄 Open Selected Report"
                                Width="180"
                                Height="36"
                                Margin="4,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenReportCommand}"
                                CommandParameter="{Binding SelectedReport}"/>
                        <Button Content="📂 Open Containing Folder"
                                Width="190"
                                Height="36"
                                Margin="4,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenReportLocationCommand}"
                                CommandParameter="{Binding SelectedReport}"/>
                    </WrapPanel>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>
